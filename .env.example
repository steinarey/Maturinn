# Postgres connection. In docker-compose this points at the bundled dev db.
DATABASE_URL=postgresql://maturinn:maturinn@localhost:5433/maturinn
# Schema the app's tables live in (created on first migration).
DB_SCHEMA=maturinn
# Where uploaded photos are stored (mount a volume here in Docker).
PHOTOS_DIR=./data/photos
DEFAULT_LANG=is

# LLM provider: anthropic | openai | gemini. Leave empty to disable LLM features.
PROVIDER=
# Model name as the provider's API knows it, e.g.
#   anthropic: claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5  (short forms like haiku-5.5 also work)
#   openai:    gpt-5.1-mini
#   gemini:    gemini-3.7-flash
LLM=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Later phase
SHOPPING_ENABLED=false
